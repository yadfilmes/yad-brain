.obsidian/cache
.trash/

# Cofre-lite: originais de terceiros NUNCA entram no Git.
# Ficam fora do repositório; aqui guardamos só manifesto (URL + hash) e destilação.
_cofre/
*.pdf

# Python (scripts de build/validação)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Temporários
*.tmp
*.log

# Artefatos derivados: gerados por tools/build_graph.py a cada commit.
# Versionamos porque servem de consulta rápida (o Claude lê o índice pronto).
# Se um dia pesarem, basta remover daqui — nada se perde, é tudo derivado.
